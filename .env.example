# Copy to .env and fill in. 
# Every value below is optional and with none of them set the service runs on the mock adapters and needs no credential.

# Which adapter serves each endpoint. Options: mock,gemini
TRANSCRIBE_PROVIDER=mock
OCR_PROVIDER=mock

# Required only when a provider above is set to gemini. Get one by asking me for a key or use one of yours.
GEMINI_API_KEY=

# Upload size ceiling in bytes. Default is 25 MB.
MAX_UPLOAD_BYTES=26214400
